# PostgreSQL URL for the app and the db:migrate/db:seed scripts. On HX-15 it lives in ~/.config/hx-centcom/app.env (mode 600); nothing loads this file automatically.
DATABASE_URL=
# Optional decided-decision webhook. Set both or neither: comma-separated http(s) receiver URLs, and the absolute path of a mode-600 file that holds the HMAC-SHA256 signing secret.
CENTCOM_WEBHOOK_URLS=
CENTCOM_WEBHOOK_SECRET_FILE=
